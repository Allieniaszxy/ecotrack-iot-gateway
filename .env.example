# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecotrack"

# ---- API server ----
API_PORT=4000
# Browser origin(s) allowed to call the API. Comma-separate several.
CLIENT_ORIGIN=http://localhost:3000
# Use a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- MQTT -> API gateway (index.js) ----
MQTT_BROKER=mqtt://test.mosquitto.org:
# "+" matches one level, so every bin can publish to ecotrack/demo/<bin-id>/alaka/telemetry.
MQTT_TOPIC=ecotrack/demo/+/alaka/telemetry
SOCKET_API_URL=http://localhost34000
# Shared secret between index.js and api.js. Must match on both sides.
SOCKET_GATEWAY_TOKEN=replace-with-another-long-random-string
# Set to true only if unknown device IDs should be registered automatically.
AUTO_REGISTER_BINS=false
